@model learnApp.Models.Order
@using learnApp.Helper
@{
    ViewData["Title"] = "Chi tiết HĐ";
}

<h1>Chi tiết hóa đơn</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalAmount)
        </dt>
        <dd class = "col-sm-10">
            @CurrencyHelper.ToVnd(Model.TotalAmount)
        </dd>
        <dt class="col-sm-2">Đã thanh toán</dt>
        <dd class="col-sm-10">
            @CurrencyHelper.ToVnd(Model.PaidAmount)
        </dd>
        <dt class="col-sm-2">Còn nợ</dt>
        <dd class="col-sm-10">
            @CurrencyHelper.ToVnd(Model.TotalAmount - Model.PaidAmount)
        </dd>
        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">
            @Model.PaymentStatus
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.CustomerName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Employee)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Employee.EmployeeName)
        </dd>
    </dl>
    <h4>Sản phẩm đã đặt</h4>
    <hr />
    <table class="table">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Đơn vị tính</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
        @{
            decimal total = 0;
        }
        @foreach(OrderDetail item in Model.OrderDetails)
        {
            var thanhTien = item.Quantity * item.UnitPrice;
            total += thanhTien;
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Product.Unit</td>
                <td>@item.Quantity</td>
                <td>@CurrencyHelper.ToVnd(item.UnitPrice)</td>
                <td>@CurrencyHelper.ToVnd(thanhTien)</td>
            </tr>
        }
        <tr>
            <td colspan="4" class="text-end"><strong>Tổng tiền:</strong></td>
            <td><strong>@CurrencyHelper.ToVnd(total)</strong></td>
        </tr>
    </table>
    @* <h4>Lịch sử thanh toán</h4>
    <table class="table">
        <tr>
            <th>Ngày</th>
            <th>Số tiền</th>
        </tr>
        @if(!Model.Payments.Any())
        {
            <tr>
                <td colspan="2" class="text-center">Chưa có lịch sử thanh toán</td>
            </tr>
        }
        @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate))
        {
            <tr>
                <td>@p.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@CurrencyHelper.ToVnd(p.Amount)</td>
            </tr>
        }
    </table> *@
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrderId">Edit</a> |
    <a asp-action="Print" asp-route-orderId="@Model?.OrderId" class="btn btn-success">
        In hóa đơn
    </a> |
    <a asp-controller="Payments"
           asp-action="Create"
           asp-route-orderId="@Model?.OrderId"
           class="btn btn-warning">
        Thanh toán
    </a> |
    <a asp-action="Index">Back to List</a>
</div>
