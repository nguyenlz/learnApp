@model learnApp.Models.Order
@using learnApp.Helper

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    decimal conNo = Model.TotalAmount - Model.PaidAmount;
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff text-primary"></i>
                Chi tiết hóa đơn
            </h2>
            <p class="text-muted mb-0">
                Mã hóa đơn: <strong>#@Model.OrderId</strong>
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
                   asp-route-id="@Model.OrderId"
                   class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa
            </a>

            <a asp-action="Print"
                   asp-route-orderId="@Model.OrderId"
                   class="btn btn-success">
                <i class="bi bi-printer"></i>
                In hóa đơn
            </a>

            <a asp-controller="CustomerPayments"
                   asp-action="Create"
                   asp-route-customerId="@(Model.CustomerId > 0 ? Model.CustomerId : null)"
                   asp-route-siteId="@(Model.SiteId > 0 ? Model.SiteId : null)"
                   class="btn btn-warning text-white">
                <i class="bi bi-cash-coin"></i>
                Thanh toán
            </a>
        </div>
    </div>

    <div class="row">

        <!-- LEFT -->
        <div class="col-lg-8">

            <!-- Thông tin hóa đơn -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-text"></i>
                        Thông tin hóa đơn
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="text-muted small">Ngày đặt hàng</label>
                            <div class="fw-semibold">
                                @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Trạng thái</label>
                            <div>
                                @if (conNo <= 0)
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Đã thanh toán
                                    </span>
                                }
                                else if (Model.PaidAmount > 0)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        Thanh toán một phần
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        Chưa thanh toán
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Khách hàng</label>
                            <div class="fw-semibold">
                                @if (Model.SiteId > 0)
                                {
                                    <text>@Model.Customer?.CustomerName - @Model.Site?.Name</text>
                                }
                                else
                                {
                                    @Model.Customer?.CustomerName
                                }
                                @* @Model.Customer?.CustomerName - @Model.Site?.Name *@
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Nhân viên phụ trách</label>
                            <div class="fw-semibold">
                                @Model.Employee?.EmployeeName
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-box-seam"></i>
                        Danh sách sản phẩm
                    </h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-center">Ghi chú</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    decimal total = 0;
                                }

                                @foreach (OrderDetail item in Model.OrderDetails)
                                {
                                    var thanhTien = item.Quantity * item.UnitPrice;
                                    total += thanhTien;

                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                @item.Product?.ProductName
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            @item.Product?.Unit
                                        </td>

                                        <td class="text-center">
                                            @item.Quantity
                                        </td>

                                        <td class="text-end">
                                            @CurrencyHelper.ToVnd(item.UnitPrice)
                                        </td>

                                        <td class="text-end fw-semibold">
                                            @CurrencyHelper.ToVnd(thanhTien)
                                        </td>

                                        <td class="text-center">
                                            @item.Note
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="4" class="text-end fs-6">
                                        Tổng cộng:
                                    </th>
                                    <th class="text-end text-danger fs-5">
                                        @CurrencyHelper.ToVnd(total)
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <!-- Tổng quan thanh toán -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-wallet2"></i>
                        Tổng quan thanh toán
                    </h5>
                </div>

                <div class="card-body">

                    <div class="border rounded p-3 mb-3">
                        <div class="text-muted small">
                            Tổng hóa đơn
                        </div>
                        <div class="fs-4 fw-bold text-dark">
                            @CurrencyHelper.ToVnd(Model.TotalAmount)
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="text-muted small">
                            Đã thanh toán
                        </div>
                        <div class="fs-4 fw-bold text-success">
                            @CurrencyHelper.ToVnd(Model.PaidAmount)
                        </div>
                    </div>

                    <div class="border rounded p-3">
                        <div class="text-muted small">
                            Còn nợ
                        </div>

                        <div class="fs-4 fw-bold @(conNo > 0 ? "text-danger" : "text-success")">
                            @CurrencyHelper.ToVnd(conNo)
                        </div>
                    </div>

                </div>
            </div>

            <!-- Điều hướng -->
            <div class="card shadow-sm border-0">
                <div class="card-body d-grid gap-2">

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>
            </div>

        </div>

    </div>
</div>