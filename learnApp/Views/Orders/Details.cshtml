@model learnApp.Models.Order
@using learnApp.Helper
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrderDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalAmount)
        </dt>
        <dd class = "col-sm-10">
            @CurrencyHelper.ToVnd(Model.TotalAmount)
            @* @Html.DisplayFor(model => model.TotalAmount) *@
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.CustomerName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Employee)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Employee.EmployeeName)
        </dd>
    </dl>
    <h4>Order Detail</h4>
    <table class="table">
        <tr>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>UnitPrice</th>
            <th>Thành tiền</th>
        </tr>
        @foreach(OrderDetail item in Model.OrderDetails)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@CurrencyHelper.ToVnd(item.UnitPrice)</td>
                <td>@CurrencyHelper.ToVnd(item.Quantity * item.UnitPrice)</td>
            </tr>
        }
    </table>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrderId">Edit</a> |
    <a asp-action="Print" asp-route-id="@Model.OrderId" class="btn btn-success">
        In hóa đơn
    </a> |
    <a asp-action="Index">Back to List</a>
</div>
