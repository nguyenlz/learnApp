@model learnApp.ViewModels.OrderSummaryViewModel
@using learnApp.Helper

<h2>HÓA ĐƠN TỔNG</h2>

<p><strong>Khách hàng:</strong> @Model.CustomerName</p>
@if(!string.IsNullOrEmpty(Model.SiteName) && Model.SiteId > 0)
{
    <p><strong>Công trình:</strong> @Model.SiteName</p>
}


<table class="table table-bordered">
    <tr>
        <th>STT</th>
        <th>Ngày giao</th>
        <th>Tên hàng</th>
        <th>Đơn vị</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
        <th>Ghi chú</th>
        @if (Model.SiteId <= 0 && Model.Orders.Any(o => o.Site != null))
        {
            <th>Công trình</th>
        }
    </tr>

    @{
        int stt = 1;
        decimal tong = 0;
    }

    @foreach (var order in Model.Orders)
    {
        foreach (var item in order.OrderDetails)
        {
            var thanhTien = item.Quantity * item.UnitPrice;
            tong += thanhTien;

            <tr>
                <td>@stt</td>
                <td>@order.OrderDate</td>
                <td>@item.Product.ProductName</td>
                <td>@item.Product.Unit</td>
                <td>@CurrencyHelper.FormatQuantity(item.Quantity)</td>
                <td>@CurrencyHelper.ToVnd(item.UnitPrice)</td>
                <td>@CurrencyHelper.ToVnd(thanhTien)</td>
                <td></td>
                @if (Model.SiteId <= 0 && order.Site != null)
                {
                    <td>@order.Site.Name</td>
                }
            </tr>

            stt++;
        }
    }

    <tr>
        <td colspan="6" class="text-end"><strong>Tổng cộng:</strong></td>
        <td><strong>@CurrencyHelper.ToVnd(tong)</strong></td>
        <td></td>
    </tr>
    @if (Model.PaidAmount > 0)
    {
        <tr>
            <td colspan="6" class="text-end text-danger"><strong>Đã thanh toán:</strong></td>
            <td class="text-danger"><strong>@CurrencyHelper.ToVnd(Model.PaidAmount)</strong></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" class="text-end"><strong>Còn lại:</strong></td>
            <td><strong>@CurrencyHelper.ToVnd(Model.TotalAmount - Model.PaidAmount)</strong></td>
            <td></td>
        </tr>
    }
</table>

<a asp-action="PrintSummary"
       asp-route-customerId="@(Model.CustomerId > 0 ? Model.CustomerId : null)"
       asp-route-siteId="@(Model.SiteId > 0 ? Model.SiteId : null)"
       class="btn btn-success">
    In hóa đơn
</a>

<a asp-controller="CustomerPayments" asp-action="Create"
       asp-route-customerId="@(Model.CustomerId > 0 ? Model.CustomerId : null)"
       asp-route-siteId="@(Model.SiteId > 0 ? Model.SiteId : null)"
       class="btn btn-warning">
    Thanh toán
</a>