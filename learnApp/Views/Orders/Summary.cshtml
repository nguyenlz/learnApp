@model learnApp.ViewModels.OrderSummaryViewModel
@using learnApp.Helper

<h2>HÓA ĐƠN TỔNG</h2>

<p><strong>Khách hàng:</strong> @Model.CustomerName</p>
@* <p><strong>Từ ngày:</strong> @Model.FromDate.ToString("dd/MM/yyyy")</p>
<p><strong>Đến ngày:</strong> @Model.ToDate.ToString("dd/MM/yyyy")</p> *@

<table class="table table-bordered">
    <tr>
        <th>STT</th>
        <th>Ngày giao</th>
        <th>Tên hàng</th>
        <th>Đơn vị</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
        <th>Ghi chú</th>
    </tr>

    @{
        int stt = 1;
        decimal tong = 0;
    }

    @foreach (var order in Model.Orders)
    {
        foreach (var item in order.OrderDetails)
        {
            var thanhTien = item.Quantity * item.UnitPrice;
            tong += thanhTien;

            <tr>
                <td>@stt</td>
                <td>@order.OrderDate</td>
                <td>@item.Product.ProductName</td>
                <td>@item.Product.Unit</td>
                <td>@item.Quantity</td>
                <td>@CurrencyHelper.ToVnd(item.UnitPrice)</td>
                <td>@CurrencyHelper.ToVnd(thanhTien)</td>
                <td></td>
            </tr>

            stt++;
        }
    }

    <tr>
        <td colspan="6" class="text-end"><strong>Tổng cộng:</strong></td>
        <td><strong>@CurrencyHelper.ToVnd(tong)</strong></td>
        <td></td>
    </tr>
</table>

<a asp-action="PrintSummary"
       asp-route-customerId="@Model.CustomerId"
       asp-route-fromDate="@Model.FromDate"
       asp-route-toDate="@Model.ToDate"
       class="btn btn-success">
    In hóa đơn
</a>