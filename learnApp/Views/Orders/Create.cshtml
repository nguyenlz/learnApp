@model learnApp.ViewModels.OrderCreateViewModel
@using learnApp.Helper

@{
    ViewData["Title"] = "Create";
}

<h2>Tạo đơn hàng</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<form asp-action="Create" onsubmit="beforeSubmit()">
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="card-section-title">
                Thông tin đơn hàng
            </div>

            <div class="row g-3">

                <div class="col-md-3">
                    <label class="form-label form-label-custom">
                        Khách hàng
                    </label>

                    <select asp-for="Order.CustomerId"
                            class="form-select"
                            asp-items="ViewBag.CustomerId"
                            onchange="loadSites(this)">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label form-label-custom">
                        Nhân viên
                    </label>

                    <select asp-for="Order.EmployeeId"
                            class="form-select"
                            asp-items="ViewBag.EmployeeId">
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label form-label-custom">
                        Công trình
                    </label>

                    <select asp-for="Order.SiteId"
                            class="form-select"
                            disabled>
                        <option value="">-- Chọn công trình --</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label form-label-custom">
                        Ngày tạo đơn
                    </label>

                    <input asp-for="Order.OrderDate"
                           type="datetime-local"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control" />
                </div>

            </div>

        </div>
    </div>
    @* <div class="row">
        <div class="col-md-4">

            <select asp-for="Order.CustomerId"
                    class="form-control"
                    asp-items="ViewBag.CustomerId"
                    onchange="loadSites(this)">
                <option value="">-- Chọn khách hàng --</option>
            </select>

            <div class="form-group">
                <label>Nhân viên</label>
                <select asp-for="Order.EmployeeId" class="form-control" asp-items="ViewBag.EmployeeId"></select>
            </div>

            <div class="form-group">
                <label>Công trình</label>
                <select asp-for="Order.SiteId" class="form-control" disabled>
                    <option value="">-- Chọn công trình --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Ngày</label>
                <input asp-for="Order.OrderDate" type="datetime-local" class="form-control" />
            </div>

        </div>
    </div>

    <hr /> *@

    <h4 class="card-section-title mt-4">
        Danh sách sản phẩm
    </h4>

    <table class="table table-bordered align-middle" id="orderDetailsTable">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th class="text-end">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
                <th width="80"></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <button type="button" class="btn btn-success" onclick="addRow()">+ Thêm sản phẩm</button>

    <hr />

    <button type="submit" class="btn btn-primary">Lưu đơn</button>
</form>

@section Scripts {
<script>
    let index = 0;

    function addRow() {
        let currentIndex = index;
        let row = `
        <tr>
            <td style="min-width:420px;">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text"
                           class="form-control product-search"
                           placeholder="Tìm sản phẩm..."
                            style="max-width:160px;"
                           onkeyup="filterProducts(this)" />

                    <select name="OrderDetails[${currentIndex}].ProductId"
                            class="form-select"
                            onchange="loadPrice(this)">
                        ${getProductOptions()}
                    </select>
                </div>
            </td>
            <td style="width:120px">
                <input name="OrderDetails[${currentIndex}].Quantity"
                   type="number"
                   step="any"
                   class="form-control"
                   value="1"
                   onchange="calculate(this)" />
            </td>
            <td style="width:180px">
                <input name="OrderDetails[${currentIndex}].UnitPrice"
                   type="text"
                   class="form-control"
                   value="0"
                   onfocus="unformatPrice(this)"
                   onblur="formatPrice(this)"
                   onchange="calculate(this)" />
            </td>
            <td class="total text-end money-text">
                0 ₫
            </td>
            <td style="width:80px" class="text-center">
                <button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button>
            </td>
        </tr>
        `;
        document.querySelector("#orderDetailsTable tbody").insertAdjacentHTML('beforeend', row);
        index++;
    }

    function removeRow(btn) {
        btn.closest('tr').remove();
    }

    function calculate(input) {
        let row = input.closest('tr');

        let qty = parseFloat(
            row.querySelector('[name*="Quantity"]').value
        ) || 0;

        let price = parseInt(
            row.querySelector('[name*="UnitPrice"]').value.replace(/\./g, '')
        ) || 0;

        let total = qty * price;

        row.querySelector('.total').innerText =
            total.toLocaleString('vi-VN') + ' ₫';
    }

    function loadPrice(select) {
        let row = select.closest('tr');

        let price = parseInt(
            select.options[select.selectedIndex].getAttribute("data-price")
        ) || 0;

        let priceInput = row.querySelector('[name*="UnitPrice"]');

        // set raw value trước
        priceInput.value = price;

        // format lại cho đẹp
        formatPrice(priceInput);

        calculate(priceInput);
    }

    function formatPrice(input) {
        let value = parseInt(input.value.replace(/\./g, '')) || 0;
        input.value = value.toLocaleString('vi-VN'); // 1400 -> 1.400
    }

    function unformatPrice(input) {
        input.value = input.value.replace(/\./g, ''); // 1.400 -> 1400
    }

    function getProductOptions() {
        return `@Html.Raw(ViewBag.ProductOptions)`;
    }

    function beforeSubmit() {
        // bỏ dấu . của tiền
        document.querySelectorAll('[name*="UnitPrice"]').forEach(input => {
            input.value = input.value.replace(/\./g, '');
        });

        // chuẩn hoá số lẻ
        document.querySelectorAll('[name*="Quantity"]').forEach(input => {
            input.value = input.value.replace(',', '.');
        });
    }

    function loadSites(select) {
        let customerId = select.value;

        if (!customerId) return;

        fetch('@Url.Action("GetSitesByCustomer", "Orders")' + '?customerId=' + customerId)
            .then(res => {
                if (!res.ok) {
                    throw new Error("Lỗi khi gọi API");
                }
                return res.json();
            })
            .then(data => {
                let siteSelect = document.querySelector('[name="Order.SiteId"]');

                // reset dropdown
                siteSelect.innerHTML = '<option value="">-- Chọn công trình --</option>';

                if (!data || data.length === 0) {
                    siteSelect.disabled = true;
                    return;
                }

                siteSelect.disabled = false;

                data.forEach(site => {
                    let option = document.createElement("option");
                    option.value = site.siteId;
                    option.textContent = site.name;
                    siteSelect.appendChild(option);
                });
            })
            .catch(err => {
                console.error(err);
                alert("Không load được công trình");
            });
    }

    function removeVietnameseTones(str) {

        return str
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d")
            .replace(/Đ/g, "D")
            .toLowerCase();
    }
    
    function filterProducts(input) {

        let keyword = removeVietnameseTones(input.value);

        let td = input.closest('td');

        let select = td.querySelector('select');

        let hasVisible = false;

        for (let option of select.options) {

            let text = removeVietnameseTones(option.text);

            let match = text.includes(keyword);

            option.hidden = !match;

            if (match) {
                hasVisible = true;
            }
        }

        // tự chọn option đầu tiên phù hợp
        if (hasVisible) {

            let firstVisible = [...select.options]
                .find(o => !o.hidden);

            if (firstVisible) {
                select.value = firstVisible.value;
                loadPrice(select);
            }
        }
    }
</script>
}

<style>

    .form-label-custom {
        font-size: 15px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .card-section-title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
    }

    .table thead th {
        background-color: #f8fafc;
        color: #334155;
        font-weight: 700;
        vertical-align: middle;
    }

    .table td {
        vertical-align: middle;
    }

    .money-text {
        font-weight: 600;
        color: #0f172a;
    }

</style>