@model learnApp.ViewModels.OrderCreateViewModel
@using learnApp.Helper

@{
    ViewData["Title"] = "Tạo đơn hàng";
}

@* @if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
} *@

<form asp-action="Create" id="orderForm">

    <!-- ORDER INFO -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <h5 class="section-title">
                🧾 Thông tin đơn hàng
            </h5>

            <div class="row g-3">

                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Khách hàng</label>

                    <select asp-for="Order.CustomerId"
                            id="customerSelect"
                            class="form-select"
                            asp-items="ViewBag.CustomerId"
                            onchange="loadSites(this)">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Nhân viên</label>

                    <select asp-for="Order.EmployeeId"
                            class="form-select"
                            asp-items="ViewBag.EmployeeId">
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Công trình</label>

                    <select asp-for="Order.SiteId"
                            id="siteSelect"
                            class="form-select"
                            disabled>
                        <option value="">-- Chọn công trình --</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label-custom">Ngày tạo</label>

                    <input asp-for="Order.OrderDate"
                           type="date"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

            </div>
        </div>
    </div>

    <!-- PRODUCTS -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="section-title mb-0">
                    📦 Danh sách sản phẩm
                </h5>

                <button type="button"
                        class="btn btn-success"
                        onclick="addRow()">

                    <i class="fa-solid fa-plus"></i>
                    Thêm sản phẩm

                </button>

            </div>

            <div class="table-responsive">

                <table class="table align-middle" id="orderTable">

                    <thead>
                        <tr>
                            <th style="min-width:320px;">Sản phẩm</th>
                            <th width="110" class="text-end">SL</th>
                            <th width="150" class="text-end">Đơn giá</th>
                            <th width="80" class="text-center">Đai</th>
                            <th width="180">Ghi chú</th>
                            <th width="160" class="text-end">Thành tiền</th>
                            <th width="60"></th>
                        </tr>
                    </thead>

                    <tbody></tbody>

                </table>
            </div>
        </div>
    </div>

    <!-- Error -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" asp-validation-summary="All">
            @* @TempData["Error"] *@
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- TOTAL -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <div class="text-muted small">
                    Tổng thanh toán
                </div>

                <h3 id="grandTotal" class="mb-0 fw-bold text-primary">
                    0 ₫
                </h3>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg px-4">

                <i class="fa-solid fa-check"></i>
                Lưu đơn hàng

            </button>

        </div>
    </div>   

</form>

@section Scripts {

    <script>

        let index = 0;

        const tableBody = document.querySelector('#orderTable tbody');

        const PRODUCT_OPTIONS = `@Html.Raw(ViewBag.ProductOptions)`;

        // =========================
        // FORMAT
        // =========================

        const formatMoney = value =>
            Number(value || 0).toLocaleString('vi-VN') + ' ₫';

        const parseMoney = value =>
            Number(String(value || 0).replace(/[^\d]/g, '')) || 0;

        // =========================
        // ADD ROW
        // =========================

        function addRow() {
            tableBody.insertAdjacentHTML('beforeend', createRow(index));

            const row = tableBody.lastElementChild;

            updatePrice(row);

            index++;

            setTimeout(() => {

            let searches =
                document.querySelectorAll(".product-search");

            searches[searches.length - 1].focus();

        }, 50);
        }

        function createRow(i) {

            return `
            <tr>

                <td>

                    <div class="d-flex gap-2">

                        <input type="text"
                               class="form-control product-search"
                               placeholder="Tìm..." />

                        <select name="OrderDetails[${i}].ProductId"
                                class="form-select product-select">
                            <option value="">-- Chọn sản phẩm --</option>

                            ${PRODUCT_OPTIONS}

                        </select>

                    </div>

                </td>

                <td>

                    <input name="OrderDetails[${i}].Quantity"
                           type="number"
                           step="0.01"
                           min="0.01"
                           value="1"
                           class="form-control text-end quantity-input" />

                </td>

                <td>

                    <input name="OrderDetails[${i}].UnitPrice"
                           type="text"
                           value="0"
                           class="form-control text-end price-input" />

                </td>

                <td class="text-center">

                    <input type="checkbox"
                       class="form-check-input processing-check"
                       data-field="IsSteelProcessing" />

                </td>

                <td>

                    <textarea name="OrderDetails[${i}].Note"
                              rows="1"
                              class="form-control"
                              placeholder="Ghi chú"></textarea>

                </td>

                <td class="text-end fw-semibold total-cell"
                    data-total="0">

                    0 ₫

                </td>

                <td class="text-center">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger remove-btn">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </td>

            </tr>
            `;
        }

        function reIndexRows() {

            document.querySelectorAll('#orderTable tbody tr')
                .forEach((row, index) => {

                    row.querySelectorAll('[name]')
                        .forEach(input => {

                            input.name = input.name.replace(
                                /OrderDetails\[\d+\]/,
                                `OrderDetails[${index}]`
                            );
                        });
                });
        }

        // =========================
        // EVENT DELEGATION
        // =========================

        document.addEventListener('input', e => {

            // search product
            if (e.target.classList.contains('product-search')) {
                filterProducts(e.target);
            }

            // quantity
            if (
                e.target.classList.contains('quantity-input')
            ) {
                calculateRow(e.target.closest('tr'));
            }
        });

        document.addEventListener('change', e => {

            // select product
            if (e.target.classList.contains('product-select')) {
                updatePrice(e.target.closest('tr'));
            }

            // processing
            if (e.target.classList.contains('processing-check')) {
                updatePrice(e.target.closest('tr'));
            }
        });

        document.addEventListener('click', e => {

            // remove row
            if (e.target.closest('.remove-btn')) {

                e.target.closest('tr').remove();

                reIndexRows();

                calculateGrandTotal();
            }
        });

        document.addEventListener('blur', e => {

            if (e.target.classList.contains('price-input')) {

                e.target.value =
                    parseMoney(e.target.value)
                        .toLocaleString('vi-VN');

                calculateRow(e.target.closest('tr'));
            }

        }, true);

        // =========================
        // PRICE
        // =========================

        function updatePrice(row) {

            const select = row.querySelector('.product-select');

            const option = select.options[select.selectedIndex];

            const processing =
                row.querySelector('.processing-check').checked;

            let price =
                parseInt(option.dataset.price || 0);

            if (processing) {
                price += 2500;
            }

            const priceInput =
                row.querySelector('.price-input');

            priceInput.value =
                price.toLocaleString('vi-VN');

            calculateRow(row);
        }

        function calculateRow(row) {

            const qty =
                parseFloat(
                    row.querySelector('.quantity-input').value
                ) || 0;

            const price =
                parseMoney(
                    row.querySelector('.price-input').value
                );

            const total = qty * price;

            const totalCell =
                row.querySelector('.total-cell');

            totalCell.dataset.total = total;

            totalCell.innerText = formatMoney(total);

            calculateGrandTotal();
        }

        function calculateGrandTotal() {

            let total = 0;

            document.querySelectorAll('.total-cell')
                .forEach(td => {

                    total += parseFloat(td.dataset.total || 0);
                });

            document.getElementById('grandTotal')
                .innerText = formatMoney(total);
        }

        // =========================
        // SEARCH PRODUCT
        // =========================

        function removeVietnameseTones(str) {

            return str
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d")
                .replace(/Đ/g, "D")
                .toLowerCase();
        }

        function filterProducts(input) {

            const keyword =
                removeVietnameseTones(input.value);

            const row = input.closest('tr');

            const select =
                row.querySelector('.product-select');

            let firstMatch = null;

            [...select.options].forEach(option => {

                const match =
                    removeVietnameseTones(option.text)
                        .includes(keyword);

                option.hidden = !match;

                if (match && !firstMatch) {
                    firstMatch = option;
                }
            });

            if (firstMatch) {

                select.value = firstMatch.value;

                updatePrice(row);
            }
        }

        // =========================
        // SUBMIT
        // =========================

        document.getElementById('orderForm').addEventListener('submit', () => {

            document.querySelector('[name="Order.SiteId"]')
                .disabled = false;

            document.querySelectorAll('.price-input')
                .forEach(input => {
                    input.value = parseMoney(input.value);
                });

            document.querySelectorAll('.generated-hidden')
                .forEach(x => x.remove());

            reIndexRows();

            document.querySelectorAll('#orderTable tbody tr')
                .forEach((row, index) => {

                    const checkbox =
                        row.querySelector('.processing-check');

                    const hidden =
                        document.createElement('input');

                    hidden.type = 'hidden';

                    hidden.name =
                        `OrderDetails[${index}].IsSteelProcessing`;

                    hidden.value =
                        checkbox.checked;

                    hidden.classList.add('generated-hidden');

                    row.appendChild(hidden);
                });
        });

        // select customer and site
        let customerTom;
        let siteTom;

        document.addEventListener("DOMContentLoaded", () => {

            customerTom = new TomSelect("#customerSelect", {
                valueField: "id",
                labelField: "name",
                searchField: "name",

                load: async function(query, callback) {

                    const res = await fetch(
                        `/Orders/SearchCustomers?q=${query}`
                    );

                    callback(await res.json());
                }
            });

            siteTom = new TomSelect("#siteSelect", {
                create: false
            });

        });


        // =========================
        // LOAD SITE
        // =========================

        async function loadSites(select) {

            const customerId = select.value;

            if (!customerId) {

                siteTom.clear();
                siteTom.clearOptions();
                siteTom.disable();

                return;
            }

            try {

                const response = await fetch(
                    '@Url.Action("GetSitesByCustomer", "Orders")?customerId=' + customerId
                );

                const data = await response.json();

                siteTom.clear();
                siteTom.clearOptions();

                data.forEach(site => {

                    siteTom.addOption({
                        value: site.siteId,
                        text: site.name
                    });

                });

                if (data.length > 0) {
                    siteTom.enable();
                } else {
                    siteTom.disable();
                }

                siteTom.refreshOptions(false);
            }
            catch {

                alert('Không load được công trình');
            }
        }

    </script>
}

<style>

    body {
        background: #f8fafc;
    }

    .section-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
    }

    .form-label-custom {
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .price-input,
    .quantity-input {
        min-width: 100px;
    }

    textarea.form-control {
        resize: none;
    }

    .card {
        border-radius: 16px;
    }

    .btn {
        border-radius: 10px;
    }
</style>