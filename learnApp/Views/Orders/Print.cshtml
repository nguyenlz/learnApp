@model learnApp.Models.Order
@using learnApp.Helper

<style>
    body {
        font-family: Arial;
        padding: 20px;
    }

    .header {
        text-align: center;
    }

    .info {
        margin-top: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    table, th, td {
        border: 1px solid black;
    }

    th, td {
        padding: 8px;
        text-align: center;
    }

    .right {
        text-align: right;
    }

    .total {
        font-size: 18px;
        font-weight: bold;
    }
</style>

<div class="header">
    <h2>CỬA HÀNG VLXD XUÂN LẠC</h2>
    <p>Địa chỉ: Quốc lộ 1A, Vạn Ninh, Khánh Hòa</p>
    <p>SĐT: 0978 026 168</p>
</div>

<hr />

<div class="info">
    <p><strong>Mã đơn:</strong> @Model.OrderId</p>
    <p><strong>Ngày:</strong> @Model.OrderDate</p>
    <p><strong>Khách hàng:</strong> @Model.Customer.CustomerName</p>
    <p><strong>Nhân viên:</strong> @Model.Employee.EmployeeName</p>
</div>

<table>
    <tr>
        <th>Sản phẩm</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
    </tr>
    @foreach (var item in Model.OrderDetails)
    {
        <tr>
            <td>
                @if(item.IsSteelProcessing)
                {
                    <span>@item.Note</span>
                }
                else
                {
                    <span>@item.Product.ProductName</span>
                }
            </td>
            <td>@item.Quantity</td>
            <td>@CurrencyHelper.ToVnd(item.UnitPrice)</td>
            <td>@CurrencyHelper.ToVnd(item.Quantity * item.UnitPrice)</td>
        </tr>
    }
</table>

<p class="right total">
    Tổng tiền: @CurrencyHelper.ToVnd(Model.TotalAmount)
</p>

<br />
<br />

<div style="display:flex; justify-content: space-between;">
    <div>
        <p><strong>Khách hàng</strong></p>
        <br /><br />
        <p>(Ký tên)</p>
    </div>

    <div>
        <p><strong>Nhân viên</strong></p>
        <br /><br />
        <p>(Ký tên)</p>
    </div>
</div>

<br />
<p style="text-align:center;">Cảm ơn quý khách!</p>