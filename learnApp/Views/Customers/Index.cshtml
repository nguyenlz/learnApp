@model IEnumerable<learnApp.Models.Customer>

@{
    ViewData["Title"] = "Khách hàng";

    int totalCustomers = Model.Count();
    int retailCustomers = Model.Count(x => x.Type == 0);
    int companyCustomers = Model.Count(x => x.Type != 0);
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-people-fill text-primary me-2"></i>
                Quản lý khách hàng

            </h2>

            <div class="text-muted">

                Theo dõi khách hàng, công trình và công nợ

            </div>

        </div>

        <a asp-action="Create"
               class="btn btn-primary px-4 rounded-pill shadow-sm">

            <i class="bi bi-plus-circle me-1"></i>

            Tạo khách hàng

        </a>

    </div>

    <!-- STATS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Tổng khách hàng
                            </div>

                            <h2 class="fw-bold mb-0">
                                @totalCustomers
                            </h2>

                        </div>

                        <div class="icon-box bg-primary-subtle text-primary">

                            <i class="bi bi-people-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Khách lẻ
                            </div>

                            <h2 class="fw-bold mb-0">
                                @retailCustomers
                            </h2>

                        </div>

                        <div class="icon-box bg-success-subtle text-success">

                            <i class="bi bi-person-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Công ty / công trình
                            </div>

                            <h2 class="fw-bold mb-0">
                                @companyCustomers
                            </h2>

                        </div>

                        <div class="icon-box bg-warning-subtle text-warning">

                            <i class="bi bi-buildings-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- SEARCH -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-lg-10">

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="bi bi-search"></i>

                            </span>

                            <input type="search"
                                   name="searchbarinput"
                                   value="@Context.Request.Query["searchbarinput"]"
                                   class="form-control"
                                   placeholder="Tìm theo tên khách hàng, số điện thoại..." />

                        </div>

                    </div>

                    <div class="col-lg-2 d-grid">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Tìm kiếm

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Danh sách khách hàng
                    </h5>

                    <div class="text-muted small">
                        Hiển thị @Model.Count() khách hàng
                    </div>

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:300px">
                            Khách hàng
                        </th>

                        <th style="min-width:220px">
                            Liên hệ
                        </th>

                        <th style="min-width:220px">
                            Địa chỉ
                        </th>

                        <th class="text-center">
                            Loại
                        </th>

                        <th class="text-end"
                            style="min-width:320px">
                            Thao tác
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- CUSTOMER -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div>

                                            <div class="fw-semibold text-dark">

                                                @item.CustomerName

                                            </div>

                                            <div class="small text-muted">

                                                Mã KH:
                                                #@item.CustomerId

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- CONTACT -->
                                <td>

                                    <div class="small">

                                        <div class="mb-1">

                                            <i class="bi bi-telephone-fill text-success me-1"></i>

                                            @item.Phone

                                        </div>

                                        <div class="text-muted">

                                            <i class="bi bi-envelope-fill me-1"></i>

                                            @(string.IsNullOrWhiteSpace(item.Email)
                                                ? "Chưa cập nhật"
                                                : item.Email)

                                        </div>

                                    </div>

                                </td>

                                <!-- ADDRESS -->
                                <td>

                                    <div class="small text-muted">

                                        <i class="bi bi-geo-alt-fill me-1"></i>

                                        @(string.IsNullOrWhiteSpace(item.Address)
                                            ? "Chưa cập nhật"
                                            : item.Address)

                                    </div>

                                </td>

                                <!-- TYPE -->
                                <td class="text-center">

                                    @if (item.Type == 0)
                                    {
                                        <span class="badge rounded-pill bg-info-subtle text-info px-3 py-2">

                                            <i class="bi bi-person-fill me-1"></i>

                                            Khách lẻ

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">

                                            <i class="bi bi-buildings-fill me-1"></i>

                                            Công ty

                                        </span>
                                    }

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a asp-action="Details"
                                               asp-route-id="@item.CustomerId"
                                               class="btn btn-light border btn-sm rounded-pill">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.CustomerId"
                                               class="btn btn-primary btn-sm rounded-pill">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        @if (item.Type == 0)
                                        {
                                            <a asp-controller="Orders"
                                                   asp-action="Summary"
                                                   asp-route-customerId="@item.CustomerId"
                                                   asp-route-type="unpaid"
                                                   class="btn btn-info btn-sm rounded-pill text-white">

                                                <i class="bi bi-box-seam me-1"></i>

                                                Gom đơn

                                            </a>
                                        }

                                        <a asp-action="Summary"
                                               asp-route-customerId="@item.CustomerId"
                                               class="btn btn-warning btn-sm rounded-pill">

                                            <i class="bi bi-cash-stack me-1"></i>

                                            Công nợ

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.CustomerId"
                                               class="btn btn-outline-danger btn-sm rounded-pill">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="py-4">

                                    <i class="bi bi-people display-3 text-secondary"></i>

                                    <h5 class="mt-3 fw-bold">

                                        Không tìm thấy khách hàng

                                    </h5>

                                    <div class="text-muted">

                                        Hãy thử từ khóa khác hoặc tạo khách hàng mới

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    body {
        background-color: #f5f7fb;
    }

    .card {
        border-radius: 20px;
    }

    .table thead th {
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        border-bottom: 0;
        padding-top: 16px;
        padding-bottom: 16px;
        white-space: nowrap;
    }

    .table tbody td {
        padding-top: 18px;
        padding-bottom: 18px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .customer-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient( 135deg, #0d6efd, #6ea8fe );
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 20px;
        flex-shrink: 0;
    }

    .icon-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .input-group-text,
    .form-control {
        height: 48px;
    }

    .btn {
        font-weight: 500;
    }

    .table tbody tr {
        transition: 0.15s;
    }

        .table tbody tr:hover {
            background-color: #fafafa;
        }

</style>