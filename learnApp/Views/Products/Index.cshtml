@model IEnumerable<learnApp.Models.Product>
@using learnApp.Helper
@{
    ViewData["Title"] = "Sản phẩm";
}

<h1>Sản phẩm</h1>
<p>
    <a asp-action="Create">Tạo mới</a>
</p>
<form asp-action="Index" method="get" class="card shadow-sm p-3 mb-3">
    <div class="mb-3">
        <div class="input-group">
            <input type="search" name="searchbarinput"
                   value="@Context.Request.Query["searchbarinput"]"
                   class="form-control"
                   placeholder="Nhập từ khóa..." />

            <button type="submit" class="btn btn-primary px-4">
                <i class="fa-solid fa-magnifying-glass"></i> Tìm
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Reset
            </a>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Unit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StockQuantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category.CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Supplier.SupplierName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit)
            </td>
            <td>
                @CurrencyHelper.ToVnd(item.Price)
            </td>
            <td>
                @CurrencyHelper.FormatQuantity(item.StockQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.SupplierName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>