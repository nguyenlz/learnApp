@model IEnumerable<learnApp.Models.Supplier>

@{
    ViewData["Title"] = "Nhà cung cấp";

    int totalSuppliers = Model.Count();

    int newThisMonth = Model.Count(x =>
        x.CreatedAt.HasValue &&
        x.CreatedAt.Value.Month == DateTime.Now.Month &&
        x.CreatedAt.Value.Year == DateTime.Now.Year);
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-truck-front-fill text-primary me-2"></i>

                Quản lý nhà cung cấp

            </h2>

            <div class="text-muted">

                Theo dõi thông tin và công nợ nhà cung cấp

            </div>

        </div>

        <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4 shadow-sm">

            <i class="bi bi-plus-circle me-1"></i>

            Thêm nhà cung cấp

        </a>

    </div>

    <!-- STATS -->
    <div class="row g-3 mb-4">

        <!-- TOTAL -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">

                                Tổng nhà cung cấp

                            </div>

                            <h2 class="fw-bold mb-0">

                                @totalSuppliers

                            </h2>

                        </div>

                        <div class="icon-box bg-primary-subtle text-primary">

                            <i class="bi bi-buildings-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- NEW -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">

                                Nhà cung cấp mới tháng này

                            </div>

                            <h2 class="fw-bold mb-0">

                                @newThisMonth

                            </h2>

                        </div>

                        <div class="icon-box bg-success-subtle text-success">

                            <i class="bi bi-person-plus-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">

                        Danh sách nhà cung cấp

                    </h5>

                    <div class="text-muted small">

                        Hiển thị @Model.Count() nhà cung cấp

                    </div>

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:300px">

                            Nhà cung cấp

                        </th>

                        <th style="min-width:220px">

                            Liên hệ

                        </th>

                        <th style="min-width:260px">

                            Địa chỉ

                        </th>

                        <th>

                            Ngày tạo

                        </th>

                        <th class="text-end"
                            style="min-width:320px">

                            Thao tác

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- SUPPLIER -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div>

                                            <div class="fw-semibold text-dark">

                                                @item.SupplierName

                                            </div>

                                            <div class="small text-muted">

                                                NCC#@(item.SupplierId)

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- CONTACT -->
                                <td>

                                    <div class="small">

                                        <div class="mb-1">

                                            <i class="bi bi-telephone-fill text-success me-1"></i>

                                            @(string.IsNullOrWhiteSpace(item.Phone)
                                                ? "Chưa cập nhật"
                                                : item.Phone)

                                        </div>

                                    </div>

                                </td>

                                <!-- ADDRESS -->
                                <td>

                                    <div class="small text-muted">

                                        <i class="bi bi-geo-alt-fill me-1"></i>

                                        @(string.IsNullOrWhiteSpace(item.Address)
                                            ? "Chưa cập nhật"
                                            : item.Address)

                                    </div>

                                </td>

                                <!-- CREATED -->
                                <td>

                                    <div class="fw-medium">

                                        @item.CreatedAt?.ToString("dd/MM/yyyy")

                                    </div>

                                    <div class="small text-muted">

                                        @item.CreatedAt?.ToString("HH:mm")

                                    </div>

                                </td>

                                <!-- ACTION -->
                                <td>

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a asp-action="Details"
                                               asp-route-id="@item.SupplierId"
                                               class="btn btn-light border btn-sm rounded-pill">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.SupplierId"
                                               class="btn btn-primary btn-sm rounded-pill">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-controller="Suppliers"
                                               asp-action="Summary"
                                               asp-route-SupplierId="@item.SupplierId"
                                               class="btn btn-info btn-sm rounded-pill text-white">

                                            <i class="bi bi-cash-stack me-1"></i>

                                            Công nợ

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.SupplierId"
                                               class="btn btn-outline-danger btn-sm rounded-pill">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5">

                                <div class="py-4">

                                    <i class="bi bi-truck display-3 text-secondary"></i>

                                    <h5 class="mt-3 fw-bold">

                                        Chưa có nhà cung cấp nào

                                    </h5>

                                    <div class="text-muted">

                                        Hãy thêm nhà cung cấp để quản lý nhập hàng

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    body {
        background-color: #f5f7fb;
    }

    .card {
        border-radius: 20px;
    }

    .table thead th {
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        border-bottom: 0;
        padding-top: 16px;
        padding-bottom: 16px;
        white-space: nowrap;
    }

    .table tbody td {
        padding-top: 18px;
        padding-bottom: 18px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .table tbody tr {
        transition: 0.15s;
    }

        .table tbody tr:hover {
            background-color: #fafafa;
        }

    .supplier-avatar {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient( 135deg, #0d6efd, #6ea8fe );
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .icon-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .btn {
        font-weight: 500;
    }

</style>