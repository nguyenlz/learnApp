@model learnApp.Models.StockImport
@using learnApp.Helper

@{
    ViewData["Title"] = "Details";
}

<div>
    <h4>Phiếu nhập hàng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImportDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImportDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Employee.EmployeeName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Employee.EmployeeName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Supplier.SupplierName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Supplier.SupplierName)
        </dd>
    </dl>
</div>

<hr />
<h4>Chi tiết phiếu nhập hàng</h4>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StockImportDetails.First().Product.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StockImportDetails.First().Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StockImportDetails.First().ImportPrice)
            </th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.StockImportDetails) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Product.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImportPrice)
            </td>
        </tr>
    }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ImportId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
