@model learnApp.Models.StockImport
@using learnApp.Helper

@{
    ViewData["Title"] = "Chi tiết phiếu nhập";

    decimal total =
        Model.StockImportDetails.Sum(x => (x.Quantity ?? 0) * (x.ImportPrice ?? 0));

    decimal totalQty =
        Model.StockImportDetails.Sum(x => x.Quantity ?? 0);
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">

        <div class="bg-primary p-4 text-white">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <div class="small opacity-75 mb-1">
                        PHIẾU NHẬP HÀNG
                    </div>

                    <h2 class="fw-bold mb-2">
                        📦 #PN-@Model.ImportId
                    </h2>

                    <div class="d-flex flex-wrap gap-3 small">

                        <div>
                            📅 @Model.ImportDate?.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div>
                            👤 @Model.Employee?.EmployeeName
                        </div>

                        <div>
                            🏢 @Model.Supplier?.SupplierName
                        </div>

                    </div>

                </div>

                <div class="text-end">

                    <div class="small opacity-75 mb-1">
                        Tổng giá trị phiếu nhập
                    </div>

                    <div class="display-6 fw-bold">
                        @CurrencyHelper.ToVnd(total)
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <!-- PRODUCT TABLE -->
            <div class="card border-0 shadow-sm">

                <div class="card-body p-0">

                    <div class="p-4 border-bottom">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                            <div>

                                <h5 class="fw-bold mb-1">
                                    🛒 Danh sách sản phẩm
                                </h5>

                                <div class="text-muted small">
                                    @Model.StockImportDetails.Count sản phẩm trong phiếu nhập
                                </div>

                            </div>

                            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">

                                Tổng SL:
                                @totalQty

                            </span>

                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th style="width:50%">
                                        Sản phẩm
                                    </th>

                                    <th class="text-center">
                                        Số lượng
                                    </th>

                                    <th class="text-end">
                                        Giá nhập
                                    </th>

                                    <th class="text-end">
                                        Thành tiền
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.StockImportDetails)
                                {
                                    decimal rowTotal =
                                        (item.Quantity ?? 0)
                                        * (item.ImportPrice ?? 0);

                                    <tr>

                                        <td>

                                            <div class="d-flex align-items-center gap-3">

                                                <div class="product-icon">

                                                    📦

                                                </div>

                                                <div>

                                                    <div class="fw-semibold">

                                                        @item.Product?.ProductName

                                                    </div>

                                                    <div class="small text-muted">

                                                        Mã SP:
                                                        #@item.ProductId

                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                        <td class="text-center">

                                            <span class="badge bg-light text-dark border px-3 py-2">

                                                @item.Quantity

                                            </span>

                                        </td>

                                        <td class="text-end fw-medium">

                                            @CurrencyHelper.ToVnd(item.ImportPrice ?? 0)

                                        </td>

                                        <td class="text-end fw-bold text-primary">

                                            @CurrencyHelper.ToVnd(rowTotal)

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <!-- SUMMARY -->
            <div class="card border-0 shadow-sm sticky-top"
                 style="top:90px">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        💰 Tổng kết phiếu nhập
                    </h5>

                    <div class="summary-item">

                        <span class="text-muted">
                            Mã phiếu
                        </span>

                        <span class="fw-semibold">
                            #PN-@Model.ImportId
                        </span>

                    </div>

                    <div class="summary-item">

                        <span class="text-muted">
                            Nhà cung cấp
                        </span>

                        <span class="fw-semibold text-end">
                            @Model.Supplier?.SupplierName
                        </span>

                    </div>

                    <div class="summary-item">

                        <span class="text-muted">
                            Nhân viên
                        </span>

                        <span class="fw-semibold">
                            @Model.Employee?.EmployeeName
                        </span>

                    </div>

                    <div class="summary-item">

                        <span class="text-muted">
                            Tổng sản phẩm
                        </span>

                        <span class="fw-semibold">
                            @Model.StockImportDetails.Count
                        </span>

                    </div>

                    <div class="summary-item">

                        <span class="text-muted">
                            Tổng số lượng
                        </span>

                        <span class="fw-semibold">
                            @totalQty
                        </span>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="small text-muted">
                                Tổng tiền
                            </div>

                            <div class="fs-3 fw-bold text-primary">

                                @CurrencyHelper.ToVnd(total)

                            </div>

                        </div>

                    </div>

                    <hr />

                    <div class="d-grid gap-2">

                        <a asp-action="Edit"
                               asp-route-id="@Model.ImportId"
                               class="btn btn-primary btn-lg rounded-pill">

                            ✏️ Chỉnh sửa phiếu nhập

                        </a>

                        <a asp-action="Index"
                               class="btn btn-light border rounded-pill">

                            ← Quay lại danh sách

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    body {
        background: #f5f7fb;
    }

    .card {
        border-radius: 22px !important;
    }

    .table thead th {
        background: #f8fafc !important;
        border-bottom: none;
        color: #6b7280;
        font-size: 14px;
        font-weight: 600;
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .table tbody td {
        padding-top: 18px;
        padding-bottom: 18px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .table tbody tr {
        transition: 0.15s;
    }

    .table tbody tr:hover {
        background: #fafafa;
    }

    .product-icon {

        width: 52px;
        height: 52px;

        border-radius: 14px;

        background: linear-gradient(
            135deg,
            #e0f2fe,
            #dbeafe
        );

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 24px;

    }

    .summary-item {

        display: flex;
        justify-content: space-between;
        align-items: start;

        gap: 12px;

        margin-bottom: 18px;

    }

    .badge {
        font-size: 13px;
    }

</style>