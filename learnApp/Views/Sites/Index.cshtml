@model IEnumerable<learnApp.Models.Site>

@{
    ViewData["Title"] = "Công trình";

    int totalSites = Model.Count();

    int totalCustomers = Model
        .Select(x => x.CustomerId)
        .Distinct()
        .Count();
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-buildings-fill text-primary me-2"></i>

                Quản lý công trình

            </h2>

            <div class="text-muted">

                Theo dõi công trình và đơn hàng theo từng khách hàng

            </div>

        </div>

        <a asp-action="Create"
               class="btn btn-primary rounded-pill px-4 shadow-sm">

            <i class="bi bi-plus-circle me-1"></i>

            Tạo công trình

        </a>

    </div>

    <!-- STATS -->
    <div class="row g-3 mb-4">

        <!-- TOTAL SITES -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">

                                Tổng công trình

                            </div>

                            <h2 class="fw-bold mb-0">

                                @totalSites

                            </h2>

                        </div>

                        <div class="icon-box bg-primary-subtle text-primary">

                            <i class="bi bi-buildings-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- TOTAL CUSTOMERS -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-2">

                                Khách hàng sở hữu công trình

                            </div>

                            <h2 class="fw-bold mb-0">

                                @totalCustomers

                            </h2>

                        </div>

                        <div class="icon-box bg-success-subtle text-success">

                            <i class="bi bi-people-fill"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-lg-10">

                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="bi bi-search"></i>

                            </span>

                            <input type="search"
                                   name="searchbarinput"
                                   value="@Context.Request.Query["searchbarinput"]"
                                   class="form-control"
                                   placeholder="Tìm theo tên khách hàng, số điện thoại..." />

                        </div>

                    </div>

                    <div class="col-lg-2 d-grid">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Tìm kiếm

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <h5 class="fw-bold mb-1">

                        Danh sách công trình

                    </h5>

                    <div class="text-muted small">

                        Hiển thị @Model.Count() công trình

                    </div>

                </div>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th style="min-width:300px">

                            Công trình

                        </th>

                        <th style="min-width:260px">

                            Khách hàng

                        </th>

                        <th class="text-end"
                            style="min-width:320px">

                            Thao tác

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- SITE -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="site-avatar">

                                            <i class="bi bi-building"></i>

                                        </div>

                                        <div>

                                            <div class="fw-semibold text-dark">

                                                @item.Name

                                            </div>

                                            <div class="small text-muted">

                                                Mã CT:
                                                #@item.SiteId

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- CUSTOMER -->
                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="customer-dot"></div>

                                        <div>

                                            <div class="fw-medium">

                                                @item.Customer?.CustomerName

                                            </div>

                                            <div class="small text-muted">

                                                Chủ công trình

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- ACTION -->
                                <td>

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a asp-action="Details"
                                               asp-route-id="@item.SiteId"
                                               class="btn btn-light border btn-sm rounded-pill">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.SiteId"
                                               class="btn btn-primary btn-sm rounded-pill">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-controller="Orders"
                                               asp-action="Summary"
                                               asp-route-siteId="@item.SiteId"
                                               class="btn btn-info btn-sm rounded-pill text-white">

                                            <i class="bi bi-box-seam me-1"></i>

                                            Gom đơn

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.SiteId"
                                               class="btn btn-outline-danger btn-sm rounded-pill">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="3"
                                class="text-center py-5">

                                <div class="py-4">

                                    <i class="bi bi-buildings display-3 text-secondary"></i>

                                    <h5 class="mt-3 fw-bold">

                                        Chưa có công trình nào

                                    </h5>

                                    <div class="text-muted">

                                        Hãy tạo công trình mới để quản lý đơn hàng

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    body {
        background-color: #f5f7fb;
    }

    .card {
        border-radius: 20px;
    }

    .table thead th {
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        border-bottom: 0;
        padding-top: 16px;
        padding-bottom: 16px;
        white-space: nowrap;
    }

    .table tbody td {
        padding-top: 18px;
        padding-bottom: 18px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .table tbody tr {
        transition: 0.15s;
    }

        .table tbody tr:hover {
            background-color: #fafafa;
        }

    .site-avatar {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: linear-gradient( 135deg, #0d6efd, #6ea8fe );
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .icon-box {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .customer-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #198754;
        flex-shrink: 0;
    }

    .btn {
        font-weight: 500;
    }

</style>