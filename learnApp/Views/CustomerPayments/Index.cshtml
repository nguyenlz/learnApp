@model IEnumerable<learnApp.Models.CustomerPayment>
@using learnApp.Helper

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Customer.CustomerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Site.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>            
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Site.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentDate)
            </td>
            <td>
                @CurrencyHelper.ToVnd(item.Amount)
            </td>            
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.CustomerPaymentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CustomerPaymentId">Details</a> |
                <a asp-action="Delete" 
                    asp-route-id="@item.CustomerPaymentId"
                    asp-route-customerId="@item.CustomerId"
                    asp-route-siteId="@item.SiteId"
                >
                    Delete
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
