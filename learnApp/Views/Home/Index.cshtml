@model learnApp.ViewModels.Dashboard.DashboardViewModel
@using learnApp.Helper

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard Quản Lý Cửa Hàng VLXD</h2>
            <p class="text-muted mb-0">
                Theo dõi doanh thu, lợi nhuận và công nợ
            </p>
        </div>

        <div>
            <input type="date" class="form-control" />
        </div>
    </div>

    <!-- TAB MENU -->
    <ul class="nav nav-tabs mb-4" id="dashboardTabs">
        <li class="nav-item">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#tongquan">
                Tổng Quan
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#congno">
                Công Nợ
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- TAB TỔNG QUAN -->
        <div class="tab-pane fade show active" id="tongquan">

            <!-- KPI -->
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 dashboard-card revenue">
                        <div class="card-body">
                            <h6 class="text-muted">Tổng đã bán</h6>
                            <h3 class="fw-bold">@CurrencyHelper.ToVnd(Model.TotalSales)</h3>
                            <small class="text-success">+8%</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 dashboard-card revenue">
                        <div class="card-body">
                            <h6 class="text-muted">Doanh Thu</h6>
                            <h3 class="fw-bold">@CurrencyHelper.ToVnd(Model.TotalRevenue)</h3>
                            <small class="text-success">+12%</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 dashboard-card profit">
                        <div class="card-body">
                            <h6 class="text-muted">Lợi Nhuận</h6>
                            <h3 class="fw-bold">@CurrencyHelper.ToVnd(Model.TotalProfit)</h3>
                            <small class="text-success">+8%</small>
                        </div>
                    </div>
                </div>        

                @* <div class="col-md-3">
                    <div class="card shadow-sm border-0 dashboard-card cash">
                        <div class="card-body">
                            <h6 class="text-muted">Tiền Mặt</h6>
                            <h3 class="fw-bold">@CurrencyHelper.ToVnd(Model.TotalCustomerDebt)</h3>
                            <small class="text-primary">Hiện có</small>
                        </div>
                    </div>
                </div> *@

                <div class="col-md-3">
                    <div class="card shadow-sm border-0 dashboard-card inventory">
                        <div class="card-body">
                            <h6 class="text-muted">Tồn Kho</h6>
                            <h3 class="fw-bold">0đ</h3>
                            <small class="text-warning">Kho hiện tại</small>
                        </div>
                    </div>
                </div>

            </div>

            <!-- BIỂU ĐỒ + TOP -->
            <div class="row g-4">

                <!-- BIỂU ĐỒ -->
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Doanh Thu & Lợi Nhuận</h5>
                        </div>

                        <div class="card-body">
                            <canvas id="revenueChart" height="120"></canvas>
                        </div>
                    </div>
                </div>

                <!-- TOP SẢN PHẨM -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Top Sản Phẩm</h5>
                        </div>

                        <div class="card-body">
                            @if(!Model.TopProducts.Any())
                            {
                                <p class="text-muted">Chưa có dữ liệu</p>
                            }
                            @foreach (var item in Model.TopProducts)
                            {
                                <div class="mb-3">

                                    <div class="d-flex justify-content-between">
                                        <span>@item.ProductName</span>
                                        <span>@item.Revenue.ToString("N0") đ</span>
                                    </div>

                                    <div class="progress">
                                        <div class="progress-bar" style="width:70%"></div>
                                    </div>

                                </div>
                            }
                            

                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- TAB CÔNG NỢ -->
        <div class="tab-pane fade" id="congno">

            <div class="row g-4">

                <!-- KHÁCH NỢ -->
                <div class="col-lg-6">

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <h5 class="mb-0 text-info">
                                Công Nợ Khách Hàng
                            </h5>
                        </div>

                        <div class="card-body table-responsive">

                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Khách</th>
                                        <th>Công Trình</th>
                                        <th>Số Nợ</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!Model.CustomerDebts.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="text-muted text-center">Không có nợ</td>
                                        </tr>
                                    }
                                    @foreach (var item in Model.CustomerDebts)
                                    {
                                        <tr>
                                            <td>@item.CustomerName</td>
                                            <td>@item.SiteName</td>
                                            <td class="text-danger fw-bold">
                                                @item.DebtAmount.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    </div>

                </div>

                <!-- NỢ NCC -->
                <div class="col-lg-6">

                    <div class="card shadow-sm border-0">

                        <div class="card-header bg-white">
                            <h5 class="mb-0 text-info">
                                Công Nợ Nhà Cung Cấp
                            </h5>
                        </div>

                        <div class="card-body table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Nhà Cung Cấp</th>
                                        @* <th>Hạn</th> *@
                                        <th>Số Nợ</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!Model.SupplierDebts.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="text-muted text-center">Không có nợ</td>
                                        </tr>
                                    }

                                    @foreach (var item in Model.SupplierDebts)
                                    {
                                        <tr>
                                            <td>@item.SupplierName</td>
@*                                             <td>
                                                <span class="badge bg-danger">
                                                    @item. ngày
                                                </span>
                                            </td> *@
                                            <td class="text-danger fw-bold">
                                                @CurrencyHelper.ToVnd(item.DebtAmount)
                                            </td>
                                        </tr>
                                    }                                   
                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <!-- ChartJS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx = document.getElementById('revenueChart');

        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7'],
        datasets: [
        {
        label: 'Doanh Thu',
        data: [20, 35, 28, 40, 50, 42],
        borderWidth: 1
        },
        {
        label: 'Lợi Nhuận',
        data: [5, 10, 8, 12, 15, 13],
        type: 'line'
        }
        ]
        }
        });

    </script>
}

<style>

    .dashboard-card {
    border-left: 5px solid;
    border-radius: 12px;
    }

    .dashboard-card.revenue {
    border-color: #0d6efd;
    }

    .dashboard-card.profit {
    border-color: #198754;
    }

    .dashboard-card.cash {
    border-color: #20c997;
    }

    .dashboard-card.inventory {
    border-color: #ffc107;
    }

    .card {
    border-radius: 12px;
    }

</style>