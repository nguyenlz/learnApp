@model IEnumerable<learnApp.Models.StockImportDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ImportId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImportPrice)
            </th>             
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Import.ImportId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Product.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImportPrice)
            </td>
            <td>
                <a asp-action="Edit" asp-route-ImportId="@item.ImportId" asp-route-ProductId="@item.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-ImportId="@item.ImportId" asp-route-ProductId="@item.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-ImportId="@item.ImportId" asp-route-ProductId="@item.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
